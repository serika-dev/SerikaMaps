# ─── Serika Maps Configuration ────────────────────────────────
# Copy to .env and edit for your environment.
# Docker Compose and the application read from this file.

# Public URL where the web frontend is accessible
PUBLIC_URL=http://localhost:3000

# Public URL where the API backend is accessible
PUBLIC_URL_API=http://localhost:4001

# TomTom Traffic API key. Read only by the server to draw live traffic.
# Never put this in the Android app or in a NEXT_PUBLIC_ variable.
TOMTOM_API=
